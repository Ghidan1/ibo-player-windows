<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>IBOPlayer</AssemblyName>
    <RootNamespace>IBOPlayer</RootNamespace>
    <Version>1.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>IBOPlayer</Company>
    <Description>IBO Player - IPTV player for Windows: M3U link/file, Xtream Codes, MAC portal, Live TV, Movies, Series, EPG, multi-screen, parental controls, themes.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <PackageReference Include="LibVLCSharp.WinForms" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
  </ItemGroup>

</Project>
